
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Excel to Grid</title>
 
  <style>
     
body {
  font-family: Arial, sans-serif;
  margin: 0px;
  overflow-x: hidden;
}

.grid-container {
  margin-top: 20px;
  overflow-x: auto;
  max-width: 100%;
}

.gridjs-table {
  table-layout: auto !important;
  width: auto !important;
  min-width: 100%;
}

.gridjs-th, .gridjs-td {
   word-wrap: break-word;
  padding: 8px 12px;
  max-width: 800px;
   overflow-wrap: break-word;
}

.gridjs-tr:nth-child(even) {
  background-color: blue;
}

.gridjs-tr:nth-child(odd) {
  background-color: #ffffff;
}

.gridjs-thead {
  position: sticky;
  top: 0;
  background-color: #eaeaea;
  z-index: 1;
}

.gridjs thead tr th {
  white-space: normal !important;
  word-wrap: break-word;
  overflow-wrap: break-word;
  text-align: left;
  vertical-align: top;
}

.gridjs thead tr {
  height: auto !important;
}
/* Sticky header */
.gridjs-table thead th {
  position: sticky;
  top: 0; /* This sticks the header to the top of the grid container */
  background-color: #eaeaea;
  z-index: 2;
}

</style>
</head>
<body>
  <h2>Upload Excel File</h2>
  <input type="file" class="excel-upload" accept=".xlsx" />
   <button class="export-button">Export to CSV</button>
  <div class="grid-container"></div>
 
 <script>
    let currentData = [];
    let currentColumns = [];

    document.querySelector('.excel-upload').addEventListener('change', function(e) {
      const file = e.target.files[0];
      const reader = new FileReader();

      reader.onload = function(e) {
        const data = new Uint8Array(e.target.result);
        const workbook = XLSX.read(data, { type: 'array' });

        const sheetName = workbook.SheetNames[0];
        const sheet = workbook.Sheets[sheetName];
        const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 });

        currentColumns = jsonData[0];
        currentData = jsonData.slice(1);

        document.querySelector('.grid-container').innerHTML = "";

        new gridjs.Grid({
          columns: currentColumns,
          data: currentData,
          search: true,
          sort: true,
          pagination: false,
		  resizable: true 
        }).render(document.querySelector(".grid-container"));
      };

      reader.readAsArrayBuffer(file);
    });

    document.querySelector('.export-button').addEventListener('click', function() {
      if (currentColumns.length === 0 || currentData.length === 0) {
        alert("No data to export.");
        return;
      }

      let csvContent = currentColumns.join(",") + "\n";
      currentData.forEach(row => {
        csvContent += row.map(cell => `"${cell}"`).join(",") + "\n";
      });

      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "exported_data.csv";
      link.style.display = "none";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  </script>
</body>
</html>
